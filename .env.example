# Example env for local Course API — copy to .env (gitignored). Do not put real secrets here.
HTTP_ADDR=:8080
DATABASE_URL=postgres://tayjava:tayjava@localhost:5432/tayjava?sslmode=disable
ENROLLMENT_CAP_DEFAULT=30
SHUTDOWN_TIMEOUT=10s
# At least 32 bytes. Placeholder only — generate your own with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-32b!!
